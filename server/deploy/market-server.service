[Unit]
Description=Market Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=market-server
Group=market-server
WorkingDirectory=/opt/market-cli/server
Environment=HOME=/var/lib/market-server
Environment=PATH=/opt/node-v22.19.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/opt/node-v22.19.0/bin/pnpm --filter @market-cli/server start --config /etc/market-server/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/market-server
ReadOnlyPaths=/etc/market-server/config.json

[Install]
WantedBy=multi-user.target
