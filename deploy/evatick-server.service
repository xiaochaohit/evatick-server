[Unit]
Description=EVA Tick Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=evatick-server
Group=evatick-server
WorkingDirectory=/opt/evatick-server
Environment=HOME=/var/lib/evatick-server
Environment=PATH=/opt/node-v22.19.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/opt/node-v22.19.0/bin/pnpm --filter @evatick/server start --config /etc/evatick-server/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/evatick-server
ReadOnlyPaths=/etc/evatick-server/config.json

[Install]
WantedBy=multi-user.target
