[Unit]
Description=EVA data service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=evatickd
Group=evatickd
WorkingDirectory=/opt/evatick-server
Environment=HOME=/var/lib/evatickd
Environment=PATH=/opt/node-v22.19.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/opt/evatick-server/bin/evatickd --config /etc/evatickd/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/evatickd
ReadOnlyPaths=/etc/evatickd/config.json

[Install]
WantedBy=multi-user.target
